rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /reviews/{id} {
      allow read: if admin() || resource.data.approved == true;
      // Admins can publish/manage reviews. Customers can submit only their own
      // unapproved review; approval can never be granted by a customer.
      allow create: if admin()
        || (signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.approved == false);
      allow update, delete: if admin();
    }

    match /inquiries/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email);
      allow read, update, delete: if admin();
    }

    match /users/{uid} {
      // A customer can only access their own profile. Admins can read profiles
      // for the dashboard user list, but customers cannot enumerate other users.
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      // Firebase Auth owns these identity fields. Customers may set editable
      // profile fields such as name, phone and photoURL, but cannot rewrite uid,
      // email or provider in Firestore to impersonate another account.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == (request.auth.token.email == null ? '' : request.auth.token.email);
      allow update: if admin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.provider == resource.data.provider);
      allow delete: if admin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /admins/{id} {
      // Admin membership is managed from Firebase/privileged tooling. An
      // existing admin may not promote themselves by changing another doc.
      allow read: if admin() || (signedIn() && request.auth.uid == id);
      allow write: if admin();
    }

    // Explicit deny for every collection that has not been listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
