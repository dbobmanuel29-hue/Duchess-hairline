# Firebase client configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check for the web app (recommended for production)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Server-only Firebase administration credentials for secure admin user deletion.
# Store the complete service-account JSON in Vercel as a Secret. Never expose this as VITE_*.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=duchess-hairline

# Duchess Hairline Cloudinary unsigned browser uploads
# Cloud name: hosilfgo
VITE_CLOUDINARY_CLOUD_NAME=hosilfgo
# Upload preset: duchess_hairline
VITE_CLOUDINARY_UPLOAD_PRESET=duchess_hairline
