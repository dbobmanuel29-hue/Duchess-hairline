# Firebase client configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check for the web app (recommended for production)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Server-only Firebase administration credentials.
# Store the complete service-account JSON in Vercel as a Secret. Never expose this as VITE_*.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=duchess-hairline

# Server-only Cloudinary credentials for signed admin uploads.
# Never expose the API secret as VITE_*.
CLOUDINARY_CLOUD_NAME=hosilfgo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: set to false only for local troubleshooting if App Check is unavailable.
# Keep the default behavior (true) in production.
REQUIRE_FIREBASE_APP_CHECK=true
